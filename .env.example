# Sprachmodell (OpenAI-kompatible API). Standard: Groq, kostenloser Key unter https://console.groq.com/keys
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low        # leer lassen bei Anbietern ohne diesen Parameter
# LLM_TEMPERATURE=0.0           # keine Variation: Bericht und Chat sollen die Daten wiedergeben, nicht frei formulieren
# AGENT_MAX_STEPS=5
# LLM_MAX_WAIT_S=60        # längere Wartezeiten des Anbieters (Rate-Limit) werden nicht abgewartet, sondern gemeldet

# DIP-API (Pflicht). Einen öffentlichen Key veröffentlicht der Bundestag unter https://dip.bundestag.de/über-dip/hilfe/api
# (laut Bundestag zunächst bis Ende Mai 2027 gültig); für den Dauerbetrieb einen eigenen Key beantragen.
DIP_API_KEY=
# DIP_TIMEOUT_S=30
# CACHE_TTL_S=86400


